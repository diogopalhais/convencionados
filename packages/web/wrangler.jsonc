{
  // Cloudflare Workers com assets estáticos. Deploy: pnpm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convencionados",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "convencionados.xyz", "custom_domain": true },
    { "pattern": "www.convencionados.xyz", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
