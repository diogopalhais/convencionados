{
  "name": "@sns-conv/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "pnpm run sync-data && vite",
    "build": "pnpm run sync-data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry": "pnpm run build && wrangler deploy --dry-run",
    "test": "vitest run"
  },
  "dependencies": {
    "@sns-conv/schema": "workspace:*",
    "maplibre-gl": "^5.6.0",
    "minisearch": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.143.0"
  }
}
